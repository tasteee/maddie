{
  "name": "@tasteee/maddie",
  "version": "0.0.1",
  "description": "A framework-agnostic, browser-based MIDI editor. Web components on a headless core.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./elements": {
      "types": "./dist/types/elements/index.d.ts",
      "import": "./dist/elements.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/elements.js",
    "./src/elements/**",
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:playground": "vite build --config vite.playground.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "peerDependencies": {
    "@tasteee/zest": "^0.8.1"
  },
  "devDependencies": {
    "@tasteee/zest": "^0.8.1",
    "smplr": "^1.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
